---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { slugOf } from '../../utils/slug';
import { buildCategoryIndex } from '../../data/categories';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const allPosts = await getCollection('learn');
const categories = buildCategoryIndex(allPosts);
---

<BaseLayout title="分类索引" description="按知识领域分类查阅摄影教程">
  <div class="page-wrap">
    <div class="container">
      <header class="page-header">
        <h1 class="page-title">分 类 索 引</h1>
        <p class="page-subtitle">按知识领域分类查阅</p>
      </header>

      <div class="topics-grid">
        {categories.map((cat) => (
            <div class={`topic-card ${cat.status === 'soon' ? 'is-soon' : ''}`}>
              <div class="topic-card__head">
                <h2 class="topic-card__title">{cat.label}</h2>
                {cat.status === 'soon' && <span class="badge-soon">即将推出</span>}
              </div>
              <p class="topic-card__desc">{cat.desc}</p>

              {cat.posts.length > 0 && (
                <ul class="topic-card__list">
                  {cat.posts.map((post) => (
                    <li>
                      <a
                        href={`${base}/learn/${post.data.category}/${slugOf(post)}/`}
                        class="topic-card__link"
                      >
                        {post.data.title}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </div>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>

<style>
.topics-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 24px;
  padding-bottom: 80px;
}

.topic-card {
  border: 1px solid var(--border);
  padding: 28px;
  transition: all var(--transition);
}

.topic-card:hover {
  border-color: var(--fg);
}

.topic-card.is-soon {
  opacity: 0.5;
}

.topic-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8px;
}

.topic-card__title {
  font-family: var(--font-serif);
  font-size: 1.25rem;
  font-weight: 400;
  letter-spacing: 0.05em;
}

.badge-soon {
  font-size: 0.7rem;
  letter-spacing: 0.1em;
  padding: 2px 8px;
  border: 1px solid var(--border);
  border-radius: 4px;
  color: var(--fg-muted);
  font-weight: 400;
}

.topic-card__desc {
  font-size: 0.85rem;
  color: var(--fg-secondary);
  margin-bottom: 20px;
  line-height: 1.7;
}

.topic-card__list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.topic-card__link {
  font-size: 0.9rem;
  color: var(--fg-secondary);
  display: flex;
  align-items: center;
  gap: 8px;
  transition: color var(--transition);
}

.topic-card__link::before {
  content: "";
  width: 4px;
  height: 4px;
  background: var(--fg-muted);
  border-radius: 50%;
  transition: background var(--transition);
}

.topic-card__link:hover {
  color: var(--fg);
  opacity: 1;
}

.topic-card__link:hover::before {
  background: var(--fg);
}

@media (max-width: 600px) {
  .topics-grid {
    grid-template-columns: 1fr;
  }
}
</style>
