---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="装备" description="我在用的摄影器材和使用感受">
  <div class="page-wrap">
    <div class="container">
      <header class="page-header">
        <h1 class="page-title">装 备</h1>
        <p class="page-subtitle">工欲善其事，必先利其器</p>
      </header>

      <div class="placeholder">
        <svg class="placeholder__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
          <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z" />
          <circle cx="12" cy="13" r="4" />
        </svg>
        <h2 class="placeholder__title">装备页面开发中</h2>
        <p class="placeholder__text">主力装备、器材回忆录、愿望清单</p>
      </div>
    </div>
  </div>
</BaseLayout>
