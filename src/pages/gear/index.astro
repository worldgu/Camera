---
import BaseLayout from '../../layouts/BaseLayout.astro';
import gearData from '../../data/gear.json';
import GearCard from '../../components/GearCard.astro';
import worksData from '../../data/works.json';
import { countWorksForGear } from '../../utils/gear';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const sections = [
  {
    key: 'active',
    title: '正在用',
    desc: '现在背出门的这一套',
  },
  {
    key: 'retired',
    title: '曾经用过',
    desc: '走过的器材路，留个记录',
  },
  {
    key: 'wishlist',
    title: '愿望清单',
    desc: '还在种草，暂时忍住',
  },
] as const;

// 大类顺序与需求文档的七大分类体系保持一致
const typeOrder = ['camera', 'lens', 'support', 'light', 'filter', 'storage', 'bag'];

const gearBySection = sections.map((section) => ({
  ...section,
  items: gearData
    .filter((item) => item.status === section.key)
    .sort((a, b) => typeOrder.indexOf(a.type) - typeOrder.indexOf(b.type)),
}));
---

<BaseLayout title="装备" description="我在用的摄影器材和使用感受">
  <div class="page-wrap">
    <div class="container">
      <header class="page-header">
        <h1 class="page-title">装 备</h1>
        <p class="page-subtitle">工欲善其事，必先利其器</p>
      </header>

      {gearBySection.map((section) => (
        <section class="gear-section">
          <div class="gear-section__head">
            <h2 class="gear-section__title">{section.title}</h2>
            <span class="gear-section__desc">{section.desc}</span>
            <span class="gear-section__count">{section.items.length}</span>
          </div>

          {section.items.length > 0 ? (
            <div class="gear-grid">
              {section.items.map((item) => (
                <GearCard
                  item={item}
                  base={base}
                  workCount={countWorksForGear(item, worksData)}
                />
              ))}
            </div>
          ) : (
            <p class="gear-section__empty">暂无记录</p>
          )}
        </section>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
.gear-section {
  margin-bottom: 72px;
}

.gear-section__head {
  display: flex;
  align-items: baseline;
  gap: 14px;
  padding-bottom: 14px;
  margin-bottom: 28px;
  border-bottom: 1px solid var(--border);
}

.gear-section__title {
  font-family: var(--font-serif);
  font-size: 1.4rem;
  font-weight: 400;
}

.gear-section__desc {
  font-size: 0.82rem;
  color: var(--fg-muted);
}

.gear-section__count {
  margin-left: auto;
  font-size: 0.78rem;
  color: var(--fg-muted);
}

.gear-section__empty {
  font-size: 0.85rem;
  color: var(--fg-muted);
  padding: 20px 0;
}

.gear-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 28px;
  align-items: start;
}

@media (max-width: 640px) {
  .gear-section {
    margin-bottom: 56px;
  }

  .gear-grid {
    grid-template-columns: 1fr;
    gap: 24px;
  }
}
</style>
