---
import BaseLayout from '../../layouts/BaseLayout.astro';
import gearData from '../../data/gear.json';
import worksData from '../../data/works.json';
import {
  worksForGear,
  GEAR_TYPE_LABELS,
  GEAR_STATUS_LABELS,
  type GearItem,
} from '../../utils/gear';

export async function getStaticPaths() {
  return gearData.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props as { item: GearItem };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const typeLabel = GEAR_TYPE_LABELS[item.type] ?? item.type;
const statusLabel = GEAR_STATUS_LABELS[item.status] ?? item.status;

const relatedWorks = worksForGear(item, worksData).sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()
);
---

<BaseLayout title={item.name} description={`${item.name} — ${item.review.slice(0, 60)}`}>
  <div class="page-wrap">
    <div class="container">
      <nav class="gear-breadcrumb">
        <a href={`${base}/gear/`}>装备</a>
        <span class="sep">/</span>
        <span>{typeLabel}</span>
      </nav>

      <div class="gear-detail">
        <div class="gear-detail__media" style={`background: ${item.color}`}>
          <span class="gear-detail__media-text">{item.name}</span>
        </div>

        <div class="gear-detail__info">
          <div class="gear-detail__tags">
            <span class="gear-tag">{typeLabel}</span>
            <span class="gear-tag gear-tag--sub">{item.subtype}</span>
            <span class="gear-tag gear-tag--status">{statusLabel}</span>
          </div>

          <h1 class="gear-detail__name">{item.name}</h1>
          <p class="gear-detail__model">{item.model}</p>
          {item.acquiredAt && (
            <p class="gear-detail__acquired">入手时间 · {item.acquiredAt}</p>
          )}

          <p class="gear-detail__review">{item.review}</p>

          <details class="gear-detail__specs">
            <summary>主要参数</summary>
            <dl>
              {item.specs.map((spec) => (
                <div class="spec-row">
                  <dt>{spec.label}</dt>
                  <dd>{spec.value}</dd>
                </div>
              ))}
            </dl>
          </details>
        </div>
      </div>

      <section class="gear-works">
        <div class="gear-works__head">
          <h2 class="gear-works__title">用它拍的作品</h2>
          <span class="gear-works__count">{relatedWorks.length}</span>
        </div>

        {relatedWorks.length > 0 ? (
          <div class="gear-works__grid">
            {relatedWorks.map((work) => (
              <a href={`${base}/works/${work.slug}/`} class="gear-work">
                <div class="gear-work__img" style={`background: ${work.color}`}></div>
                <span class="gear-work__title">{work.title}</span>
              </a>
            ))}
          </div>
        ) : (
          <p class="gear-works__empty">
            {item.status === 'wishlist'
              ? '还没到手，暂无作品。'
              : '这件器材暂时没有关联作品。'}
          </p>
        )}
      </section>

      <div class="gear-detail__actions">
        <a href={`${base}/gear/`} class="back-link">← 返回装备</a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
.gear-breadcrumb {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 0.78rem;
  color: var(--fg-muted);
  padding: 32px 0 24px;
}

.gear-breadcrumb a {
  color: var(--fg-secondary);
}

.gear-breadcrumb a:hover {
  color: var(--fg);
}

.gear-detail {
  display: grid;
  grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
  gap: 48px;
  align-items: start;
  margin-bottom: 72px;
}

.gear-detail__media {
  aspect-ratio: 4 / 3;
  position: relative;
  overflow: hidden;
}

.gear-detail__media-text {
  position: absolute;
  left: 24px;
  bottom: 20px;
  color: rgba(255, 255, 255, 0.82);
  font-family: var(--font-serif);
  font-size: 1rem;
}

.gear-detail__info {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.gear-detail__tags {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.gear-tag {
  font-size: 0.7rem;
  padding: 2px 8px;
  border: 1px solid var(--border);
  color: var(--fg-secondary);
}

.gear-tag--sub {
  border-style: dashed;
}

.gear-tag--status {
  border-color: var(--fg-muted);
  color: var(--fg);
}

.gear-detail__name {
  font-family: var(--font-serif);
  font-size: 1.8rem;
  font-weight: 400;
  line-height: 1.35;
}

.gear-detail__model,
.gear-detail__acquired {
  font-size: 0.8rem;
  color: var(--fg-muted);
}

.gear-detail__review {
  font-size: 0.92rem;
  line-height: 2;
  color: var(--fg-secondary);
  margin-top: 8px;
}

.gear-detail__specs {
  border-top: 1px solid var(--border);
  padding-top: 14px;
  margin-top: 12px;
}

.gear-detail__specs summary {
  font-size: 0.8rem;
  color: var(--fg-secondary);
  cursor: pointer;
  list-style: none;
  display: flex;
  align-items: center;
  gap: 6px;
}

.gear-detail__specs summary::-webkit-details-marker {
  display: none;
}

.gear-detail__specs summary::before {
  content: '+';
  color: var(--fg-muted);
  line-height: 1;
}

.gear-detail__specs[open] summary::before {
  content: '−';
}

.gear-detail__specs dl {
  margin-top: 12px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.spec-row {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  font-size: 0.8rem;
}

.spec-row dt {
  color: var(--fg-muted);
}

.spec-row dd {
  color: var(--fg-secondary);
  text-align: right;
}

.gear-works__head {
  display: flex;
  align-items: baseline;
  gap: 14px;
  padding-bottom: 14px;
  margin-bottom: 24px;
  border-bottom: 1px solid var(--border);
}

.gear-works__title {
  font-family: var(--font-serif);
  font-size: 1.2rem;
  font-weight: 400;
}

.gear-works__count {
  margin-left: auto;
  font-size: 0.78rem;
  color: var(--fg-muted);
}

.gear-works__empty {
  font-size: 0.85rem;
  color: var(--fg-muted);
  padding: 16px 0;
}

.gear-works__grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
  gap: 16px;
}

.gear-work {
  display: block;
}

.gear-work__img {
  aspect-ratio: 3 / 2;
  margin-bottom: 8px;
  transition: opacity var(--transition);
}

.gear-work:hover .gear-work__img {
  opacity: 0.82;
}

.gear-work__title {
  font-size: 0.78rem;
  color: var(--fg-secondary);
}

.gear-detail__actions {
  padding: 56px 0 80px;
}

.back-link {
  font-size: 0.82rem;
  color: var(--fg-secondary);
}

.back-link:hover {
  color: var(--fg);
}

@media (max-width: 860px) {
  .gear-detail {
    grid-template-columns: 1fr;
    gap: 28px;
    margin-bottom: 56px;
  }

  .gear-detail__name {
    font-size: 1.5rem;
  }
}
</style>
