---
import BaseLayout from '../../layouts/BaseLayout.astro';
import worksData from '../../data/works.json';

export async function getStaticPaths() {
  return worksData.map((work) => ({
    params: { slug: work.slug },
    props: { work },
  }));
}

const { work } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// 上一张 / 下一张
const sorted = [...worksData].sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()
);
const currentIndex = sorted.findIndex((w) => w.id === work.id);
const prevWork = currentIndex > 0 ? sorted[currentIndex - 1] : null;
const nextWork = currentIndex < sorted.length - 1 ? sorted[currentIndex + 1] : null;

// 分类标签中文名
const categoryLabels: Record<string, string> = {
  portrait: '人像',
  landscape: '风光',
  street: '街拍',
  still: '静物',
  other: '其他',
};
---

<BaseLayout title={work.title} description={work.description}>
  <div class="photo-page">
    {work.image ? (
      <div class="photo-page__image photo-page__image--photo">
        <img src={`${base}${work.image}`} alt={work.title} />
      </div>
    ) : (
      <div class="photo-page__image" style={{ background: work.color }}>
        <span class="photo-page__title-text">{work.title}</span>
      </div>
    )}

    <div class="container">
      <div class="photo-page__content">
        <div class="photo-page__main">
          <h1 class="photo-page__title">{work.title}</h1>
          <p class="photo-page__desc">{work.description}</p>

          <div class="photo-page__tags">
            <span class="tag">{categoryLabels[work.category]}</span>
            <span class="tag">{work.project}</span>
          </div>

          <div class="photo-page__nav">
            {prevWork ? (
              <a href={`${base}/works/${prevWork.slug}/`} class="photo-nav photo-nav--prev">
                <span class="photo-nav__label">← 上一张</span>
                <span class="photo-nav__title">{prevWork.title}</span>
              </a>
            ) : <div class="photo-nav photo-nav--empty" />}
            {nextWork ? (
              <a href={`${base}/works/${nextWork.slug}/`} class="photo-nav photo-nav--next">
                <span class="photo-nav__label">下一张 →</span>
                <span class="photo-nav__title">{nextWork.title}</span>
              </a>
            ) : <div class="photo-nav photo-nav--empty" />}
          </div>
        </div>

        <aside class="photo-page__sidebar">
          <h3 class="sidebar-title">拍摄信息</h3>
          <div class="exif-list">
            <div class="exif-row">
              <span>相机</span><span>{work.camera}</span>
            </div>
            <div class="exif-row">
              <span>镜头</span><span>{work.lens}</span>
            </div>
            <div class="exif-row">
              <span>光圈</span><span>{work.aperture}</span>
            </div>
            <div class="exif-row">
              <span>快门</span><span>{work.shutter}</span>
            </div>
            <div class="exif-row">
              <span>ISO</span><span>{work.iso}</span>
            </div>
            <div class="exif-row">
              <span>焦距</span><span>{work.focalLength}</span>
            </div>
            <div class="exif-row">
              <span>地点</span><span>{work.location}</span>
            </div>
            <div class="exif-row">
              <span>时间</span><span>{work.date}</span>
            </div>
          </div>

          <div class="share-block">
            <h3 class="sidebar-title">分享</h3>
            <div class="share-buttons">
              <button class="share-btn" data-platform="weibo" aria-label="分享到微博">微博</button>
              <button class="share-btn" data-platform="twitter" aria-label="分享到 Twitter">Twitter</button>
              <button class="share-btn" data-platform="copy" aria-label="复制链接">复制链接</button>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  // 简单的分享功能
  document.querySelectorAll('.share-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var platform = btn.getAttribute('data-platform');
      var url = window.location.href;
      var title = document.querySelector('.photo-page__title')?.textContent || '';

      if (platform === 'weibo') {
        window.open('https://service.weibo.com/share/share.php?url=' + encodeURIComponent(url) + '&title=' + encodeURIComponent(title), '_blank', 'width=600,height=400');
      } else if (platform === 'twitter') {
        window.open('https://twitter.com/intent/tweet?url=' + encodeURIComponent(url) + '&text=' + encodeURIComponent(title), '_blank', 'width=600,height=400');
      } else if (platform === 'copy') {
        navigator.clipboard.writeText(url).then(function () {
          var original = btn.textContent;
          btn.textContent = '已复制';
          setTimeout(function () { btn.textContent = original; }, 1500);
        });
      }
    });
  });
</script>

<style>
.photo-page {
  padding-top: var(--nav-height);
}

.photo-page__image {
  width: 100%;
  min-height: 70vh;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 60px;
}

/* 有真实照片时不撑满高度，按原图比例完整展示 */
.photo-page__image--photo {
  min-height: 0;
  background: var(--bg-secondary);
}

.photo-page__image--photo img {
  display: block;
  max-width: 100%;
  max-height: 82vh;
  width: auto;
  height: auto;
  object-fit: contain;
}

.photo-page__title-text {
  color: rgba(255, 255, 255, 0.85);
  font-family: var(--font-serif);
  font-size: clamp(1.5rem, 4vw, 2.5rem);
  letter-spacing: 0.15em;
  font-weight: 300;
}

.photo-page__content {
  display: grid;
  grid-template-columns: 1fr 300px;
  gap: 60px;
  padding-bottom: 80px;
}

.photo-page__title {
  font-family: var(--font-serif);
  font-size: 2rem;
  font-weight: 300;
  letter-spacing: 0.08em;
  margin-bottom: 16px;
}

.photo-page__desc {
  font-size: 1rem;
  line-height: 2;
  color: var(--fg-secondary);
  margin-bottom: 24px;
}

.photo-page__tags {
  display: flex;
  gap: 8px;
  margin-bottom: 40px;
}

.tag {
  display: inline-block;
  padding: 4px 12px;
  font-size: 0.8rem;
  color: var(--fg-secondary);
  background: var(--bg-secondary);
  border-radius: 4px;
}

.photo-page__nav {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
  padding-top: 40px;
  border-top: 1px solid var(--border);
}

.photo-nav {
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding: 20px;
  border: 1px solid var(--border);
  transition: border-color var(--transition);
}

.photo-nav:hover {
  border-color: var(--fg);
  opacity: 1;
}

.photo-nav--next {
  text-align: right;
}

.photo-nav--empty {
  border: 1px solid transparent;
}

.photo-nav__label {
  font-size: 0.8rem;
  color: var(--fg-muted);
  letter-spacing: 0.05em;
}

.photo-nav__title {
  font-family: var(--font-serif);
  font-size: 1.1rem;
  letter-spacing: 0.05em;
}

.sidebar-title {
  font-size: 0.85rem;
  font-weight: 500;
  letter-spacing: 0.1em;
  color: var(--fg-muted);
  text-transform: uppercase;
  margin-bottom: 16px;
}

.exif-list {
  margin-bottom: 40px;
}

.exif-row {
  display: flex;
  justify-content: space-between;
  font-size: 0.9rem;
  padding: 10px 0;
  border-bottom: 1px solid var(--border);
}

.exif-row span:first-child {
  color: var(--fg-muted);
}

.share-buttons {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.share-btn {
  padding: 10px 16px;
  font-size: 0.85rem;
  color: var(--fg);
  background: var(--bg-secondary);
  border: 1px solid var(--border);
  border-radius: 4px;
  cursor: pointer;
  transition: all var(--transition);
  text-align: center;
}

.share-btn:hover {
  background: var(--fg);
  color: var(--bg);
  border-color: var(--fg);
}

@media (max-width: 900px) {
  .photo-page__content {
    grid-template-columns: 1fr;
    gap: 40px;
  }

  .photo-page__image {
    min-height: 50vh;
  }
}
</style>
