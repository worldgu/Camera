---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { slugOf } from '../../../utils/slug';

export async function getStaticPaths() {
  const posts = await getCollection('learn');
  return posts.map((post) => ({
    params: {
      category: post.data.category,
      slug: slugOf(post),
    },
    props: { post },
  }));
}

const { post } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { Content } = await render(post);

// 同分类内按 order 排序，用于上一篇 / 下一篇
const allPosts = await getCollection('learn');
const sameCategory = allPosts
  .filter((p) => p.data.category === post.data.category)
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const currentIndex = sameCategory.findIndex((p) => p.id === post.id);
const prevPost = currentIndex > 0 ? sameCategory[currentIndex - 1] : null;
const nextPost = currentIndex < sameCategory.length - 1 ? sameCategory[currentIndex + 1] : null;

// 分类中文名
const categoryLabels: Record<string, string> = {
  basics: '基础篇',
  composition: '构图篇',
  light: '光线篇',
  subjects: '题材篇',
  operation: '操作篇',
  post: '后期篇',
  gear: '器材篇',
};

const categoryLabel = categoryLabels[post.data.category] || post.data.category;
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="article-page">
    <div class="container">
      <div class="article__wrap">
        <nav class="article__breadcrumb">
          <a href={`${base}/learn/`}>教程</a>
          <span class="sep">/</span>
          <a href={`${base}/learn/topics/`}>分类索引</a>
          <span class="sep">/</span>
          <span>{categoryLabel}</span>
        </nav>

        <header class="article__header">
          <div class="article__meta">
            <span class="article__category">{categoryLabel}</span>
            <span class="article__date">{post.data.date}</span>
          </div>
          <h1 class="article__title">{post.data.title}</h1>
          <p class="article__desc">{post.data.description}</p>
        </header>

        <div class="article__content">
          <Content />
        </div>

        <div class="article__tags">
          {post.data.tags.map((tag) => (
            <span class="tag">#{tag}</span>
          ))}
        </div>

        <div class="article__nav">
          {prevPost ? (
            <a href={`${base}/learn/${prevPost.data.category}/${slugOf(prevPost)}/`} class="post-nav post-nav--prev">
              <span class="post-nav__label">← 上一篇</span>
              <span class="post-nav__title">{prevPost.data.title}</span>
            </a>
          ) : <div class="post-nav post-nav--empty" />}
          {nextPost ? (
            <a href={`${base}/learn/${nextPost.data.category}/${slugOf(nextPost)}/`} class="post-nav post-nav--next">
              <span class="post-nav__label">下一篇 →</span>
              <span class="post-nav__title">{nextPost.data.title}</span>
            </a>
          ) : <div class="post-nav post-nav--empty" />}
        </div>

        <div class="article__actions">
          <a href={`${base}/learn/path/`} class="back-link">← 返回学习路径</a>
          <a href={`${base}/learn/topics/`} class="back-link">← 返回分类索引</a>
        </div>

        <div class="share-block">
          <h3 class="share-title">分享这篇教程</h3>
          <div class="share-buttons">
            <button class="share-btn" data-platform="weibo" aria-label="分享到微博">微博</button>
            <button class="share-btn" data-platform="twitter" aria-label="分享到 Twitter">Twitter</button>
            <button class="share-btn" data-platform="copy" aria-label="复制链接">复制链接</button>
          </div>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>

<script is:inline>
  document.querySelectorAll('.share-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var platform = btn.getAttribute('data-platform');
      var url = window.location.href;
      var title = document.querySelector('.article__title')?.textContent || '';

      if (platform === 'weibo') {
        window.open(
          'https://service.weibo.com/share/share.php?url=' +
            encodeURIComponent(url) +
            '&title=' +
            encodeURIComponent(title),
          '_blank',
          'width=600,height=400'
        );
      } else if (platform === 'twitter') {
        window.open(
          'https://twitter.com/intent/tweet?url=' +
            encodeURIComponent(url) +
            '&text=' +
            encodeURIComponent(title),
          '_blank',
          'width=600,height=400'
        );
      } else if (platform === 'copy') {
        navigator.clipboard.writeText(url).then(function () {
          var original = btn.textContent;
          btn.textContent = '已复制';
          setTimeout(function () {
            btn.textContent = original;
          }, 1500);
        });
      }
    });
  });
</script>

<style>
.article-page {
  padding-top: var(--nav-height);
  padding-bottom: 80px;
}

.article__wrap {
  max-width: 720px;
  margin: 0 auto;
}

.article__breadcrumb {
  font-size: 0.85rem;
  color: var(--fg-muted);
  margin-bottom: 40px;
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.article__breadcrumb a {
  color: var(--fg-muted);
  transition: color var(--transition);
}

.article__breadcrumb a:hover {
  color: var(--fg);
}

.article__breadcrumb .sep {
  opacity: 0.5;
}

.article__header {
  margin-bottom: 48px;
  padding-bottom: 32px;
  border-bottom: 1px solid var(--border);
}

.article__meta {
  display: flex;
  gap: 16px;
  align-items: center;
  margin-bottom: 20px;
  font-size: 0.85rem;
  color: var(--fg-muted);
}

.article__category {
  padding: 4px 10px;
  border: 1px solid var(--border);
  border-radius: 4px;
  letter-spacing: 0.05em;
}

.article__title {
  font-family: var(--font-serif);
  font-size: clamp(1.75rem, 4vw, 2.5rem);
  font-weight: 300;
  letter-spacing: 0.05em;
  line-height: 1.4;
  margin-bottom: 16px;
}

.article__desc {
  font-size: 1rem;
  line-height: 1.8;
  color: var(--fg-secondary);
}

.article__content {
  font-size: 1rem;
  line-height: 2;
  color: var(--fg);
  margin-bottom: 40px;
}

.article__content :global(h2) {
  font-family: var(--font-serif);
  font-size: 1.5rem;
  font-weight: 400;
  letter-spacing: 0.05em;
  margin: 48px 0 20px;
  padding-bottom: 12px;
  border-bottom: 1px solid var(--border);
}

.article__content :global(h3) {
  font-size: 1.15rem;
  font-weight: 500;
  margin: 32px 0 12px;
}

.article__content :global(p) {
  margin-bottom: 20px;
  color: var(--fg-secondary);
}

.article__content :global(strong) {
  color: var(--fg);
  font-weight: 500;
}

.article__content :global(blockquote) {
  border-left: 3px solid var(--fg);
  padding: 12px 20px;
  margin: 24px 0;
  background: var(--bg-secondary);
  font-style: italic;
  color: var(--fg);
}

.article__content :global(blockquote p) {
  margin: 0;
  color: var(--fg);
}

.article__content :global(ul),
.article__content :global(ol) {
  padding-left: 24px;
  margin-bottom: 20px;
  color: var(--fg-secondary);
}

.article__content :global(li) {
  margin-bottom: 8px;
}

.article__content :global(code) {
  font-family: var(--font-mono, monospace);
  font-size: 0.9em;
  padding: 2px 6px;
  background: var(--bg-secondary);
  border-radius: 4px;
}

.article__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 40px;
}

.tag {
  display: inline-block;
  padding: 4px 12px;
  font-size: 0.8rem;
  color: var(--fg-secondary);
  background: var(--bg-secondary);
  border-radius: 4px;
}

.article__nav {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
  padding: 32px 0;
  border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
  margin-bottom: 32px;
}

.post-nav {
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding: 20px;
  border: 1px solid var(--border);
  transition: border-color var(--transition);
}

.post-nav:hover {
  border-color: var(--fg);
  opacity: 1;
}

.post-nav--next {
  text-align: right;
}

.post-nav--empty {
  border: 1px solid transparent;
}

.post-nav__label {
  font-size: 0.8rem;
  color: var(--fg-muted);
  letter-spacing: 0.05em;
}

.post-nav__title {
  font-family: var(--font-serif);
  font-size: 1rem;
  letter-spacing: 0.03em;
}

.article__actions {
  display: flex;
  flex-wrap: wrap;
  gap: 24px;
  margin-bottom: 48px;
}

.back-link {
  font-size: 0.9rem;
  color: var(--fg-secondary);
  transition: color var(--transition);
}

.back-link:hover {
  color: var(--fg);
}

.share-block {
  text-align: center;
  padding: 32px;
  border: 1px solid var(--border);
}

.share-title {
  font-size: 0.85rem;
  font-weight: 500;
  letter-spacing: 0.1em;
  color: var(--fg-muted);
  text-transform: uppercase;
  margin-bottom: 16px;
}

.share-buttons {
  display: flex;
  gap: 12px;
  justify-content: center;
}

.share-btn {
  padding: 8px 20px;
  font-size: 0.85rem;
  color: var(--fg);
  background: transparent;
  border: 1px solid var(--border);
  border-radius: 4px;
  cursor: pointer;
  transition: all var(--transition);
}

.share-btn:hover {
  background: var(--fg);
  color: var(--bg);
  border-color: var(--fg);
}

@media (max-width: 768px) {
  .article__nav {
    grid-template-columns: 1fr;
  }

  .article-page {
    padding-bottom: 60px;
  }

  .share-buttons {
    flex-direction: column;
  }
}
</style>
